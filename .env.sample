# Map: yandex21 | yandex3
MAP_PROVIDER=yandex3
YANDEX_MAPS_API_KEY=

# Auth (MVP: hardcoded single user; HTTP Basic)
AUTH_USERNAME=
AUTH_PASSWORD=

# Data source: gis | postgis
DATA_SOURCE=gis
# Used when DATA_SOURCE=postgis (compose sets this for api service)
DATABASE_URL=postgresql://mobilemap:mobilemap@localhost:5432/mobilemap
# Optional extra gate for POST /api/sync (header X-Sync-Token)
SYNC_TOKEN=

# GIS upstream
GIS_BASE_URL=
GIS_API_TOKEN=
GIS_TIMEOUT_SECONDS=20

# Points — see docs/points.md
GIS_POINT_DETAIL_ZOOM=15
GIS_POINT_ICON_SIZE=32
GIS_POINT_CIRCLE_SIZE=22
GIS_POINT_FIXED_SIZE_MAX_ZOOM=15
# true = always ICON/CIRCLE size (ignore zoom threshold and GIS iconScale)
GIS_POINT_ICON_FIXED=false
GIS_MAX_POINT_COUNT=300
# Overview (zoom < GIS_POINT_DETAIL_ZOOM): only these icon_name values; always clickable.
# Empty = all icons, click only at/above GIS_POINT_DETAIL_ZOOM.
# Needs icon_uuid after sync/icons (e.g. arrow_down_left,camera,atom,wifi_signal).
GIS_POINT_OVERVIEW_ICONS=

# Lines — see docs/lines.md (vector) and docs/line-tiles.md (raster)
LINE_RENDER=vector
TILE_CACHE_DIR=/var/lib/mobilemap/tiles
LINE_TILE_POLES_LAYER_NAME=Линии столбов
TILE_Z_MIN=10
TILE_Z_MAX=15
GIS_MAX_LINE_VERTICES=5000
GIS_LINE_SIMPLIFY_METERS=0:50,12:20,14:8,16:2,18:0
# PostGIS LOD: backbone only below zoom 13, then all classes (vector + raster tiles)
GIS_LINE_CLASSES_BY_ZOOM=0:backbone,13:all

# Initial view when localStorage has no saved viewport: geolocation ± radius
GIS_INITIAL_RADIUS_KM=20

# Icon naming + mask extract during sync. icon_name is never overwritten; masks/colors are backfilled.
# python -m app.sync --icons-only  → extract masks for all cached/DB icons
SYNC_ICONS=true
OPEN_API_KEY=
OPEN_API_BASE=
MODEL_NAME=

# Line classification (separate command: python -m app.sync --classify-only)
LINE_CLASS_TOLERANCE_M=20
